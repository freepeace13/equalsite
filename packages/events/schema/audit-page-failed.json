{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AuditPageFailed",
    "description": "Published when the crawler exhausts retries attempting a page.",
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "version", "timestamp", "payload"],
    "properties": {
        "type": { "title": "AuditPageFailedType", "enum": ["audit.page.failed"] },
        "version": { "type": "string" },
        "timestamp": { "type": "integer" },
        "payload": {
            "title": "AuditPageFailedPayload",
            "type": "object",
            "additionalProperties": false,
            "required": ["auditId", "pageUrl", "attemptsCount", "errorMessage"],
            "properties": {
                "auditId": { "type": "string" },
                "pageUrl": { "type": "string" },
                "attemptsCount": { "type": "integer" },
                "errorMessage": { "type": "string" }
            }
        }
    }
}
