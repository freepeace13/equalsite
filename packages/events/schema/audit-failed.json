{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AuditFailed",
    "description": "Published when an audit crawl fails outright.",
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "version", "timestamp", "payload"],
    "properties": {
        "type": { "title": "AuditFailedType", "enum": ["audit.failed"] },
        "version": { "type": "string" },
        "timestamp": { "type": "integer" },
        "payload": {
            "title": "AuditFailedPayload",
            "type": "object",
            "additionalProperties": false,
            "required": ["auditId", "error"],
            "properties": {
                "auditId": { "type": "string" },
                "error": { "type": "string" }
            }
        }
    }
}
