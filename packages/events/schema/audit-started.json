{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AuditStarted",
    "description": "Published when the crawler begins processing an audit.",
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "version", "timestamp", "payload"],
    "properties": {
        "type": { "title": "AuditStartedType", "enum": ["audit.started"] },
        "version": { "type": "string" },
        "timestamp": { "type": "integer" },
        "payload": {
            "title": "AuditStartedPayload",
            "type": "object",
            "additionalProperties": false,
            "required": ["auditId"],
            "properties": {
                "auditId": { "type": "string" }
            }
        }
    }
}
