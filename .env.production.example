APP_NAME=equalsite
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Public domains this deploy answers on — used by both compose.prod.yaml
# (Caddy site blocks, container env) and the VITE_PUSHER_HOST build arg.
# Must come before APP_URL below: env_file self-interpolation only resolves
# variables already defined earlier in the same file.
APP_DOMAIN=equalsite.techysavvy.me
SOKETI_DOMAIN=ws.techysavvy.me

APP_URL=https://${APP_DOMAIN}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=equalsite
DB_USERNAME=equalsite
# Generate with: openssl rand -base64 32
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX="equalsite-database-"

# Resend SMTP relay — no extra package needed, Laravel's built-in smtp
# mailer works against it directly. Get the API key from the Resend
# dashboard and use it as the SMTP password.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Backblaze B2, S3-compatible — same bucket also used by the backups plan.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-004
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Backblaze B2 — audit-artifact zips. Separate bucket/creds from the AWS_* disk
# above: consumed directly by crawler-worker (compose.prod.yaml) and by Laravel's
# audit_artifacts disk (web/horizon/crawler-listen via env_file). Without
# AUDIT_ARTIFACTS_DRIVER=s3 here, Laravel silently falls back to an empty local disk.
AUDIT_ARTIFACTS_DRIVER=s3
AUDIT_ARTIFACTS_KEY=
AUDIT_ARTIFACTS_SECRET=
AUDIT_ARTIFACTS_REGION=us-west-004
AUDIT_ARTIFACTS_BUCKET=
AUDIT_ARTIFACTS_ENDPOINT=
AUDIT_ARTIFACTS_USE_PATH_STYLE=true

VITE_APP_NAME="${APP_NAME}"

CRAWLER_HOST=crawler-api
CRAWLER_PORT=3000
# Generate with: openssl rand -hex 32
CRAWLER_SECRET=
STREAM_NAME=equalsite:crawler:events

# Master switch for plan-based scan limits and the Billing settings UI.
MONETIZATION_ENABLED=true

# Laravel cashier-paddle — flip PADDLE_SANDBOX to false only once the
# vendor account is approved for live payments (docs/monetization.md §4).
CASHIER_WEBHOOK=
CASHIER_CURRENCY_LOCALE=
PADDLE_SANDBOX=true
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Server-side Laravel -> Soketi, over the internal Docker network directly
# (not through Caddy). Client-side browser connections go through Caddy's
# SOKETI_DOMAIN instead — see the VITE_PUSHER_* build args in compose.prod.yaml.
PUSHER_APP_ID=equalsite
# Generate with: openssl rand -hex 16
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Sentry — leave both DSNs blank to keep error reporting off; paste in real
# values from the Sentry project dashboard to activate (no other toggle
# needed, both SDKs no-op without a DSN).
SENTRY_LARAVEL_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
