{
    "editor.formatOnSave": true,
    "editor.wrappingIndent": "indent",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always"
    },
    "files.exclude": {
        "**/.turbo": true,
        "**/dist": true,
        // "**/node_modules": true
    },
    "search.exclude": {
        "**/.turbo": true,
        "**/dist": true,
        "**/node_modules": true
    },
    "typescript.tsdk": "node_modules/typescript/lib"
}